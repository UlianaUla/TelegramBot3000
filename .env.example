# Токен от @BotFather. Настоящее значение только в локальном .env.
BOT_TOKEN=

# Числовые Telegram ID менеджеров через запятую. Пусто — менеджеров нет.
MANAGER_IDS=

# Тестовый магазин ЮKassa: shopId и секретный ключ из личного кабинета.
# Пустые значения отключают онлайн-оплату, расчёт при получении продолжает работать.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта для чека ЮKassa. Для учёбы подойдёт вымышленный адрес.
YOOKASSA_RECEIPT_EMAIL=foliant-study@example.com

# Один бот магазина и финансов. Оплата через тестовый магазин ЮKassa.
PAYMENT_MODE=yookassa
MINI_APP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
INIT_DATA_TTL=3600
RESERVATION_SECONDS=120
# Не используется при redirect-оплате. Для Telegram Payments хранить только здесь.
PROVIDER_TOKEN=
